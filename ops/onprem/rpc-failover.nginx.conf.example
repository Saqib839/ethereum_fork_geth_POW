# Include inside nginx's http context on a proxy reachable by your clients.
# Replace AWS_RPC_VPN_IP, RPC_DOMAIN, and certificate paths before enabling.
# Both backends must use the SAME genesis and be synchronized first.
upstream ethereum_rpc {
    server 127.0.0.1:8545 max_fails=1 fail_timeout=10s;
    server AWS_RPC_VPN_IP:8545 backup max_fails=1 fail_timeout=10s;
}
server {
    listen 443 ssl;
    server_name RPC_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/RPC_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/RPC_DOMAIN/privkey.pem;
    location / {
        proxy_pass http://ethereum_rpc;
        proxy_set_header Host localhost;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        # Clients must retry JSON-RPC POSTs after a failed request. Do not force
        # Nginx to replay a POST that may already have submitted a transaction.
    }
}
